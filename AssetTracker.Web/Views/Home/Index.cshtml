@{
    ViewData["Title"] = "Home";
    ViewData["FullWidth"] = true;   // IMPORTANT FOR FULLSCREEN
}

<style>
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        background: transparent !important;
    }

    .hero-fullscreen {
        position: relative;
        width: 100vw;
        height: 100vh; /* FULL SCREEN NOW */
        margin-left: calc(50% - 50vw);
        background: url('/images/dashboard-bg.jpg') no-repeat center center / cover;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 650px;
        padding: 120px 70px;
        color: white;
        top: 50%;
        transform: translateY(-50%);
    }

    .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
    }

    .logo-image {
        height: 65px;
        width: auto;
    }

    .eyebrow {
        font-size: 18px;
        opacity: 0.85;
        margin-bottom: 10px;
    }

    .title {
        font-size: 56px;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 15px;
    }

    .subtitle {
        font-size: 20px;
        opacity: 0.9;
        margin-bottom: 30px;
    }

    .btn-custom {
        padding: 14px 28px;
        font-size: 18px;
        border-radius: 8px;
        margin-right: 12px;
        min-width: 200px;
    }
</style>

<div class="hero-fullscreen">
    <div class="hero-overlay"></div>

    <div class="hero-content">

        <div class="logo-wrapper">
            <img src="/images/main-logo.svg" class="logo-image" alt="Enkaytech Logo" />
        </div>

        <div class="eyebrow">Asset Management Portal</div>

        <div class="title">Admin Dashboard for IT Teams</div>

        <div class="subtitle">
            Track assets, monitor assignments, and manage employee devices — all in one secure place.
        </div>

        <a href="/Assets" class="btn btn-primary btn-custom">Manage Assets</a>
        <a href="/Employees" class="btn btn-light btn-custom">View Employees</a>
    </div>
</div>
