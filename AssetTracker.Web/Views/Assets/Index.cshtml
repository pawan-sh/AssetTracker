@model IEnumerable<AssetTracker.Core.Models.Asset>

@{
    ViewData["Title"] = "Assets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">Assets Inventory</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add New Asset</a>
</div>

<!-- Search Bar -->
<div class="search-container">
    <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-10">
            <input type="text" name="searchString" class="form-control" placeholder="Search by Type, Brand, Model, or Serial Number..." value="@ViewData["CurrentFilter"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100">Search</button>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-custom">
        <thead>
            <tr>
                <th>Type</th>
                <th>Brand & Model</th>
                <th>Serial Number</th>
                <th>Purchase Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AssetType</td>
                    <td>
                        <span class="fw-bold">@item.Brand</span> @item.Model
                    </td>
                    <td><code>@item.SerialNumber</code></td>
                    <td>@(item.PurchaseDate?.ToShortDateString() ?? "N/A")</td>
                    <td>
                        @if (item.Status == "Available")
                        {
                            <span class="badge badge-custom badge-available">Available</span>
                        }
                        else if (item.Status == "Assigned")
                        {
                            <span class="badge badge-custom badge-assigned">Assigned</span>
                        }
                        else if (item.Status == "InRepair")
                        {
                            <span class="badge badge-custom badge-repair">In Repair</span>
                        }
                        else
                        {
                            <span class="badge badge-custom badge-broken">@item.Status</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.AssetId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.AssetId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.AssetId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
