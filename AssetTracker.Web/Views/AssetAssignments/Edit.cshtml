@model AssetTracker.Core.Models.AssetAssignment

<h2>Edit Assignment</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="AssetAssignmentId" />

    <div class="form-group">
        <label>Employee</label>
        <select asp-for="EmployeeId" asp-items="ViewBag.EmployeeId" class="form-control"></select>
    </div>

    <div class="form-group mt-3">
        <label>Asset</label>
        <input class="form-control" value="@Model.Asset?.Model - @Model.Asset?.SerialNumber" disabled />
    </div>

    <div class="form-group mt-3">
        <label>Returned Date</label>
        <input asp-for="ReturnedDate" type="datetime-local" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success mt-3">Save</button>
</form>
