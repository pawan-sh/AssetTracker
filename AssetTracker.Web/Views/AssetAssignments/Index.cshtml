@model IEnumerable<AssetTracker.Core.Models.AssetAssignment>

<h2>Asset Assignments</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Assign New Asset</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Asset</th>
            <th>Employee</th>
            <th>Assigned Date</th>
            <th>Returned Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@($"{item.Asset?.AssetType} - {item.Asset?.Brand} {item.Asset?.Model} (SN: {item.Asset?.SerialNumber})")</td>

                <td>@item.Employee?.Name</td>
                <td>@item.AssignedDate.ToShortDateString()</td>
                <td>@(item.ReturnedDate?.ToShortDateString() ?? "Not Returned")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.AssetAssignmentId" class="btn btn-info btn-sm">Details</a>

                    @if (item.ReturnedDate == null)
                    {
                        <a asp-action="Return" asp-route-id="@item.AssetAssignmentId" class="btn btn-warning btn-sm">Return</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

