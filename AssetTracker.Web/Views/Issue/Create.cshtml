@model AssetTracker.Core.Models.Issue

@{
    ViewData["Title"] = "Report Issue";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Report an Issue</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @if (Model?.AssetId > 0)
                    {
                        <input type="hidden" asp-for="AssetId" />
                    }

                    <div class="mb-3">
                        <label asp-for="AssetName" class="form-label fw-bold">Asset Name</label>
                        <input asp-for="AssetName" class="form-control" required readonly="@(Model?.AssetId > 0)" />
                        @if (Model?.AssetId > 0)
                        {
                            <div class="form-text text-success">
                                <i class="bi bi-check-circle-fill"></i> Asset selected from your list.
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Issue Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" required placeholder="Please describe the problem in detail..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="MyAssets" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Submit Issue</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
