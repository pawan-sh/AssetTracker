@model IEnumerable<AssetTracker.Core.Models.AssetAssignment>

@{
    ViewData["Title"] = "My Assets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">My Assigned Assets</h2>
    <a asp-action="Create" class="btn btn-outline-primary">Report Issue for Other Asset</a>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> These are the assets currently assigned to your email address (<strong>@User.Identity?.Name</strong>).
</div>

<div class="table-responsive">
    <table class="table table-custom">
        <thead>
            <tr>
                <th>Asset Details</th>
                <th>Serial Number</th>
                <th>Assigned Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        You have no assets assigned to you at this time.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@item.Asset?.AssetType</div>
                            <div class="text-muted small">@item.Asset?.Brand @item.Asset?.Model</div>
                        </td>
                        <td><code>@item.Asset?.SerialNumber</code></td>
                        <td>@item.AssignedDate.ToShortDateString()</td>
                        <td>
                            <a asp-action="Create" asp-route-assetId="@item.AssetId" class="btn btn-warning btn-sm">
                                <i class="bi bi-exclamation-triangle"></i> Report Issue
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
