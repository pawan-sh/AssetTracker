@model AssetTracker.Core.Models.Issue

<h3>Mark Repair as Completed</h3>

<form method="post">
    <input type="hidden" name="id" value="@Model.IssueId" />

    <div class="mb-3">
        <label class="form-label">Message to Employee</label>
        <textarea name="message" class="form-control" rows="4" required>
        </textarea>
    </div>

    <button class="btn btn-success">Submit</button>
</form>
