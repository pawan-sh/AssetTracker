@using AssetTracker.Core.Models
@model IEnumerable<Issue>

<h2>All Reported Issues</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Asset</th>
            <th>Description</th>
            <th>Reported By</th>
            <th>Status</th>
            <th>Repair Details</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AssetName</td>
                <td>@item.Description</td>
                <td>@item.ReportedBy</td>

                <!-- STATUS BADGES -->
                <td>
                    @if (item.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (item.Status == "InRepair")
                    {
                        <span class="badge bg-info">In Repair</span>
                    }
                    else if (item.Status == "Completed")
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                </td>

                <!-- VIEW DETAILS BUTTON -->
                <td>
                    @if (item.Repair != null)
                    {
                        <a asp-controller="Issue"
                           asp-action="RepairDetails"
                           asp-route-id="@item.IssueId"
                           class="btn btn-outline-primary btn-sm">
                            View Details
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">Not Available</span>
                    }
                </td>

                <!-- ACTION BUTTONS -->
                <td>
                    @if (item.Status == "Pending")
                    {
                        <a class="btn btn-warning btn-sm"
                           asp-controller="Repair"
                           asp-action="Create"
                           asp-route-issueId="@item.IssueId">
                            Send to Repair
                        </a>
                    }
                    else if (item.Status == "InRepair")
                    {
                        <a class="btn btn-info btn-sm"
                           asp-controller="Issue"
                           asp-action="Details"
                           asp-route-id="@item.IssueId">
                            View Details
                        </a>

                        <a class="btn btn-secondary btn-sm"
                           asp-controller="Repair"
                           asp-action="Edit"
                           asp-route-id="@item.Repair?.RepairId">
                            Edit Repair
                        </a>

                        <!-- ⭐ NEW BUTTON: Mark Completed -->
                        <form asp-controller="Issue"
                              asp-action="MarkCompleted"
                              method="post"
                              style="display:inline;">

                            <input type="hidden" name="id" value="@item.IssueId" />

                            <input type="text"
                                   name="message"
                                   class="form-control form-control-sm d-inline-block"
                                   style="width:200px;"
                                   placeholder="Completion message" required />

                            <button type="submit"
                                    class="btn btn-success btn-sm mt-1">
                                Mark Completed
                            </button>
                        </form>

                    }
                    else if (item.Status == "Completed")
                    {
                        <span class="badge bg-success">Completed</span>

                        @* Show message to admin if exists *@
                        @if (!string.IsNullOrEmpty(item.CompletionMessage))
                        {
                            <div class="text-muted" style="font-size: 12px;">
                                <b>Message:</b> @item.CompletionMessage
                            </div>
                        }
                    }
                </td>



            </tr>
        }
    </tbody>
</table>
