@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AssetTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f5f7fb;
            display: flex;
            flex-direction: column;
        }

        /* NAVBAR */
        .navbar-custom {
            background: #0a1a3d;
            padding: 14px 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

            .navbar-custom .navbar-brand {
                color: #fff !important;
                font-size: 22px;
                font-weight: 700;
            }

            .navbar-custom .nav-link {
                color: #d7e2ff !important;
                font-weight: 500;
                padding: 10px 18px;
                border-radius: 8px;
                transition: 0.2s ease-in-out;
            }

                .navbar-custom .nav-link:hover {
                    background: rgba(255,255,255,0.12);
                    color: #fff !important;
                }

        /* MAIN CONTENT AREA */
        .main-content {
            flex: 1;
            padding: 40px 25px;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        .page-card {
            background: #fff;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.08);
        }

        /* FOOTER */
        footer {
            width: 100%;
            background: #0a1a3d;
            color: #fff;
            text-align: center;
            padding: 15px 0;
            margin-top: 0;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">AssetTracker</a>

            <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("Director"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Assets" asp-action="Index">Assets</a></li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a></li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="AssetAssignments" asp-action="Index">Assignments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Issue" asp-action="List">Issues</a></li>
                        }

                        @if (User.IsInRole("Employee") || User.IsInRole("HR"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Issue" asp-action="Create">Report Issue</a></li>
                        }

                        @if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Issue" asp-action="MyIssues">My Issues</a></li>
                        }

                        <!-- PROFILE DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light fw-bold" data-bs-toggle="dropdown">
                                @UserManager.GetUserName(User)
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item text-danger">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-primary px-3" asp-controller="Account" asp-action="Login">Login</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT AREA with FullWidth condition -->
    @if (ViewData["FullWidth"] as bool? == true)
    {
        @RenderBody()
    }
    else
    {
        <div class="main-content">
            <div class="page-card">
                @RenderBody()
            </div>
        </div>
    }

    <!-- FOOTER -->
    <footer>
        © @DateTime.Now.Year AssetTracker — Powered by EnkayTech
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
