<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AssetTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* 🟦 Glass Navigation Bar */
        .glass-nav {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .glass-nav .nav-link,
            .glass-nav .navbar-brand {
                font-size: 20px;
                font-weight: 600;
                color: #0a1a3d !important;
            }

        /* 🟩 Page Content Wrapper */
        .content-area {
            padding: 40px 60px;
        }

        /* 🚀 Home page = no padding */
        .no-padding {
            padding: 0 !important;
        }
    </style>
</head>


<body>

    <!-- NAVIGATION -->
    <header>
        <nav class="navbar glass-nav navbar-expand-sm navbar-light">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    AssetTracker
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Assets" asp-action="Index">Assets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="AssetAssignments" asp-action="Index">Assignments</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Director"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AssetAssignments" asp-action="Index">Assignments</a>
                            </li>
                        }


                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <!-- PAGE CONTENT -->
    <div class="content-area @(ViewData["NoPadding"])">
        @RenderBody()
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
