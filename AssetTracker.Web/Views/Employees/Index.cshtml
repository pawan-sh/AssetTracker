@model IEnumerable<AssetTracker.Core.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">Employee Directory</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add New Employee</a>
</div>

<!-- Search Bar -->
<div class="search-container">
    <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-10">
            <input type="text" name="searchString" class="form-control" placeholder="Search by Name, Email, or Department..." value="@ViewData["CurrentFilter"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100">Search</button>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-custom">
        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Name</td>
                    <td><span class="badge bg-light text-dark border">@item.Department</span></td>
                    <td><a href="mailto:@item.Email">@item.Email</a></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
